_type=58\\\",\\\"mime_type\\\":\\\"image\\\\\\\/png\\\",\\\"expiration_timestamp_ms\\\":\\\"1795127781000\\\",\\\"width\\\":2339,\\\"height\\\":208},\\\"latex_expression\\\":\\\"d^2 = \\\\\\\\frac{(0.60-0.40)^2}{0.40} + 0 + \\\\\\\\frac{(0.10-0.30)^2}{0.30} = 0.10 + 0.1333 = 0.2333\\\",\\\"font_height\\\":83.333333333333,\\\"padding\\\":15,\\\"item\\\":{\\\"latex_image\\\":{\\\"url\\\":\\\"https:\\\\\\\/\\\\\\\/scontent.xx.fbcdn.net\\\\\\\/v\\\\\\\/t58.90637-6\\\\\\\/914643721_1184077934178795_6619489237382978226_n.png\\\\\\\/latex.png?_nc_ht=scontent.xx.fbcdn.net&_nc_cat=103&_nc_ohc=wEqghyEr6vEQ7kNvwEu8-uu&ccb=14-4&oh=00_AQTTTs0QfW6RDdlJhbv9XUsNSlileoKglezr4DLrRm7VZA&oe=6AFF79E5&_nc_sid=9d332d\\\",\\\"url_fallback\\\":\\\"https:\\\\\\\/\\\\\\\/web.facebook.com\\\\\\\/messaging\\\\\\\/lightspeed\\\\\\\/media_fallback\\\\\\\/?entity_id=2381518438919560&entity_type=58\\\",\\\"mime_type\\\":\\\"image\\\\\\\/png\\\",\\\"expiration_timestamp_ms\\\":\\\"1795127781000\\\",\\\"width\\\":2339,\\\"height\\\":208},\\\"latex_expression\\\":\\\"d^2 = \\\\\\\\frac{(0.60-0.40)^2}{0.40} + 0 + \\\\\\\\frac{(0.10-0.30)^2}{0.30} = 0.10 + 0.1333 = 0.2333\\\",\\\"font_height\\\":83.333333333333,\\\"padding\\\":15},\\\"__typename\\\":\\\"GenAILatexUXPrimitive\\\"},\\\"__typename\\\":\\\"GenAISingleLayoutViewModel\\\"}},{\\\"view_model\\\":{\\\"primitive\\\":{\\\"text\\\":\\\"*Check of total inertia:*\\\",\\\"__typename\\\":\\\"GenAIMarkdownTextUXPrimitive\\\"},\\\"__typename\\\":\\\"GenAISingleLayoutViewModel\\\"}},{\\\"view_model\\\":{\\\"primitive\\\":{\\\"latex_image\\\":{\\\"url\\\":\\\"https:\\\\\\\/\\\\\\\/scontent.xx.fbcdn.net\\\\\\\/v\\\\\\\/t58.90637-6\\\\\\\/912425353_1334817522048073_7847438803398517328_n.png\\\\\\\/latex.png?_nc_ht=scontent.xx.fbcdn.net&_nc_cat=101&_nc_ohc=-oUuJ-mRl00Q7kNvwFptbOv&ccb=14-4&oh=00_AQQPfhgs_bhbKmdHIQsxb5XgtsirwvgbIBUWfZMJt08LuQ&oe=6AFF5C9D&_nc_sid=9d332d\\\",\\\"url_fallback\\\":\\\"https:\\\\\\\/\\\\\\\/web.facebook.com\\\\\\\/messaging\\\\\\\/l