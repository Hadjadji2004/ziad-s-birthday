_fallback\\\\\\\/?entity_id=1151003137272670&entity_type=58\\\",\\\"mime_type\\\":\\\"image\\\\\\\/png\\\",\\\"expiration_timestamp_ms\\\":\\\"1795121900000\\\",\\\"width\\\":479,\\\"height\\\":118},\\\"latex_expression\\\":\\\"30\\\\\\\/30 = 1.00\\\",\\\"font_height\\\":83.333333333333,\\\"padding\\\":15,\\\"baseline_from_bottom\\\":37,\\\"__typename\\\":\\\"GenAILatexItem\\\"}}]},{\\\"text\\\":\\\"{{IE_26}}$10\\\\\\\/30 = 0.33${{\\\\\\\/IE_26}}\\\",\\\"inline_entities\\\":[{\\\"key\\\":\\\"IE_26\\\",\\\"metadata\\\":{\\\"latex_image\\\":{\\\"url\\\":\\\"https:\\\\\\\/\\\\\\\/scontent.xx.fbcdn.net\\\\\\\/v\\\\\\\/t58.90637-6\\\\\\\/913635149_1826621645339992_1780925221076713856_n.png\\\\\\\/latex.png?_nc_ht=scontent.xx.fbcdn.net&_nc_cat=104&_nc_ohc=N668QDZ4pmsQ7kNvwHiw3G2&ccb=14-4&oh=00_AQQPjMyD84fIxSVniUVslHVw5pohP4AB_MzVJPm0_5mSHw&oe=6AFF55C6&_nc_sid=9d332d\\\",\\\"url_fallback\\\":\\\"https:\\\\\\\/\\\\\\\/web.facebook.com\\\\\\\/messaging\\\\\\\/lightspeed\\\\\\\/media_fallback\\\\\\\/?entity_id=2789657331429823&entity_type=58\\\",\\\"mime_type\\\":\\\"image\\\\\\\/png\\\",\\\"expiration_timestamp_ms\\\":\\\"1795118534000\\\",\\\"width\\\":478,\\\"height\\\":118},\\\"latex_expression\\\":\\\"10\\\\\\\/30 = 0.33\\\",\\\"font_height\\\":83.333333333333,\\\"padding\\\":15,\\\"baseline_from_bottom\\\":37,\\\"__typename\\\":\\\"GenAILatexItem\\\"}}]}]}],\\\"__typename\\\":\\\"GenATableUXPrimitive\\\"},\\\"__typename\\\":\\\"GenAISingleLayoutViewModel\\\"}},{\\\"view_model\\\":{\\\"primitive\\\":{\\\"text\\\":\\\"*Interpretation: Ratio > 1 = attraction, Ratio \\\\u003C 1 = repulsion*\\\\n\\\\n- *Town - On foot = 1.67 > 1:* strong attraction. Town students walk.\\\\n- *Village - Bus = 1.50 > 1:* strong attraction. Village students take the bus.\\\\n- *Town - Bus = 0.50* and *Village - On foot = 0.33:* strong repulsion, they are opposites.\\\\n- *Car = 1.00* everywhere: no attraction, no repulsion, independent.\\\\n\\\\n### 3. Chi-square, test of independence at 5\\\\u0025, total inertia, number of axes\\\\n\\\\nFormula: {{IE_27}}$\\\\\\\\chi^2 = \\\\\\\\sum \\\\\\\\frac{(O-E)^2}{E}${{\\\\\\\/IE_27}}\\\\n\\\\nCell by cell:\\\\n- Town-Bus: {{IE_28}}$(20-40)^2 \\\\\\\/ 40 = 400\\\\\\\/40 = 10${{\\\\\\\/IE_28}}\\\\n- Town-Car: {{IE_29}}$(30-30)^2 \\\\\\\/ 30 = 0${{\\\\\\\/IE_29}}\\\\n- Town-On foot: {{IE_30}}$(50-30)^2 \\\\\\\/ 30 = 400\\\\\\\/30 = 13.33${{\\\\\\\/IE_30}}\\\\n- Village-Bus: {{IE_31}}$(60-40)^2 \\\\\\\/ 40 = 10${{\\\\\\\/IE_31}}\\\\n- Village-Car: {{IE_32}}$0${{\\\\\\\/IE_32}}\\\\n- Village-On foot: {{IE_33}}$(10-30)^2 \\\\\\\/ 30 = 13.33${{\\\\\\\/IE_33}}\\\",\\\"inline_entities\\\":[{\\\"key\\\":\\\"IE_27\\\",\\\"metadata\\\":{\\\"latex_image\\\":{\\\"url\\\":\\\"https:\\\\\\\/\\\\\\\/scontent.xx.fbcdn.net\\\\\\\/v\\\\\\\/t58.90637-6\\\\\\\/914198676_1704628287687421_774666462843554134_n.png\\\\\\\/latex.png?_nc_ht=scontent.xx.fbcdn.net&_nc_cat=101&_nc_ohc=5pZFP_NktzIQ7kNvwHYMLrt&ccb=14-4&oh=00_AQQZaZDM8mwavfzxeUhz8LISsQjDvK-78eXgjUnmetETew&oe=6AFF5A77&_nc_sid=9d332d\\\",\\\"url_fallback\\\":\\\"https:\\\\\\\/\\\\\\\/web.facebook.com\\\\\\\/messaging\\\\\\\/lightspeed\\\\\\\/media_fallback\\\\\\\/?entity_id=1171512551984005&entity_type=58\\\",\\\"mime_type\\\":\\\"image\\\\\\\/png\\\",\\\"expiration_timestamp_ms\\\":\\\"1795119735000\\\",\\\"width\\\":563,\\\"height\\\":163},\\\"latex_expression\\\":\\\"\\\\\\\\chi^2 = \\\\\\\\sum \\\\\\\\frac{(O-E)^2}{E}\\\",\\\"font_height\\\":83.333333333333,\\\"padding\\\":15,\\\"baseline_from_bottom\\\":50.04375,\\\"__typename\\\":\\\"GenAILatexItem\\\"}},{\\\"key\\\":\\\"IE_28\\\",\\\"metadata\\\":{\\\"latex_image\\\":{\\\"url\\\":\\\"https:\\\\\\\/\\\\\\\/scontent.xx.fbcdn.net\\\\\\\/v\\\\\\\/t58.90637-6\\\\\\\/912348691_1484786083747893_8130247684055341287_n.png\\\\\\\/latex.png?_nc_ht=scontent.xx.fbcdn.net&_nc_cat=109&_nc_ohc=4NspUUP4Yi8Q7kNvwG5Qqfb&ccb=14-4&oh=00_AQQiMeEli5VfmBGZ-8FZVTHJ1QKrGrevyQ-vZFJNlP2AfQ&oe=6AFF4C22&_nc_sid=9d332d\\\",\\\"url_fallback\\\":\\\"https:\